# Copy to .env and fill in. Placeholders only; never commit real values.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key

# Model route (Meterless Nightshift Console values, or NVIDIA directly)
MODEL_BASE_URL=http://127.0.0.1:8088/v1
MODEL_API_KEY=your-nightshift-runtime-key
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Offline demonstration: replay recordings of a real run (needs none of the settings above)
SAMPLE_MODE=false
